<mxCell id="SF" value="Salesforce — the orchestrator (serial, one turn)" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#222222;strokeColor=#0176D3;fillColor=#EEF6FD;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1160" height="170" as="geometry"/></mxCell>
<mxCell id="AGENT" value="&lt;b&gt;A2ALab_Supply_Orchestrator (Agent Script)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;picks DELEGATED topology · dispatch rides&lt;br&gt;the situation as [A2A-LAB ROUTING] fanout-dispatch: async&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0176D3;fontSize=12;fontFamily=Helvetica;fontColor=#222222;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="400" height="100" as="geometry"/></mxCell>
