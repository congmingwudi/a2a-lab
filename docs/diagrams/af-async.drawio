<mxCell id="BR" value="The bridge — long-lived Fargate on an ALB (no gateway ceiling)" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#222222;strokeColor=#ED7100;fillColor=#FFF7EE;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1160" height="340" as="geometry"/></mxCell>
<mxCell id="FANOUT" value="&lt;b&gt;/invoke/fanout:supplier-disruption&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;read_dispatch_mode → async · strip_routing_blocks&lt;br&gt;so no directive reaches a leg&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontFamily=Helvetica;fontColor=#222222;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="LOOP" value="&lt;b&gt;orchestration.dispatch — submit + POLL loop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;runs HERE, during the held-open callout&lt;br&gt;(the same seam the Managed Agents host tool runs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontFamily=Helvetica;fontColor=#222222;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1120" height="90" as="geometry"/></mxCell>
