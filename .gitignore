.venv/
__pycache__/
*.pyc
.env
.a2alab/
traces/
.pytest_cache/
.ruff_cache/
dist/
.sf/
.sfdx/
tmp-docs/

# sf CLI-managed skill bundles (installed by Salesforce DX tooling)
.agents/
skills-lock.json

# ADK deploy staging (generated by deploy/adk/deploy_adk.py)
deploy/adk/_build/
deploy/shim/dist/

# ECA global OAuth settings carry the consumer key — retrieve when needed,
# never commit. Ignored rather than trusted to discipline: a `git add -A`
# swept these into a public repo on 2026-07-25 despite the standing rule.
salesforce/force-app/main/default/extlClntAppGlobalOauthSets/
# Carries the GCP service-account email, which embeds the project id.
# Same rule as above: deployable metadata that names an account does not
# live in a public repo. Backed up by ~/projects/local-project-files/sync.sh.
salesforce/force-app/main/default/externalCredentials/A2ALab_GCP.externalCredential-meta.xml

# Personal Claude Code settings: absolute paths, telemetry endpoints, and the
# permission allowlist for one developer — never shared repo config. This was
# already covered by a rule in the author's ~/.gitignore_global, which is
# exactly the problem: protection that lives outside the repository does not
# travel with a clone, so anyone else's checkout was one `git add -A` away from
# committing it. Same lesson as the line above. `.claude/` itself stays
# tracked — the saved workflows in .claude/workflows/ are shared on purpose.
**/.claude/settings.local.json

# Timestamped backups made before editing config by hand (settings, .env,
# config.toml). Convenient locally, and the last thing that should reach a
# public repo, since they hold the pre-redaction copy of whatever was fixed.
*.bak
*.bak-*
*.orig

# Kiro OTEL hook env — contains the CloudWatch bearer token fetched by
# scripts/kiro_otel.sh. Same "never on disk in the repo" posture as the
# Cursor equivalent (~/.cursorscope/.env). The hook config and forward.sh
# are committed; the credential is not.
.kiro/hooks/.env
