# ---- Anthropic (Claude agent) -------------------------------------------
ANTHROPIC_API_KEY=
# Claude hosting backend: managed (Anthropic Managed Agents beta, default)
# or sdk (self-hosted claude-agent-sdk)
CLAUDE_BACKEND=managed
# Managed Agents IDs — written by scripts/setup_managed_agent.py into
# .a2alab/managed.json; set here only to override.
#CLAUDE_MANAGED_AGENT_ID=
#CLAUDE_MANAGED_ENV_ID=
# Model for the research agent (Haiku-tier keeps Path A inside the
# Agentforce action timeout budget; A/B a Sonnet-tier later)
CLAUDE_AGENT_MODEL=claude-haiku-4-5
# Cap on one Claude answer. Needs headroom for Claude -> Agentforce (an
# Agent API round trip runs INSIDE Claude's turn, plus managed-session cold
# start). Agentforce -> Claude is governed by the tighter upstream chain
# regardless (bridge client 45s -> Apex 110s -> Agentforce action ~85-90s,
# MEASURED 2026-07-25 — this comment said ~60s until 2026-07-28, the reported
# figure the lab engineered against for six weeks without testing).
CLAUDE_ANSWER_TIMEOUT_S=100

# ---- Salesforce / Agentforce ---------------------------------------------
# My Domain host of the production org, e.g. mycompany.my.salesforce.com
SF_MY_DOMAIN=
# sf CLI alias for THIS org — the one every `sf`/DX MCP call must target.
# Named explicitly because the CLI's global `target-org` default belongs to
# whatever project was touched last, and the DX MCP server lists only an
# allow-listed subset of orgs (the lab's may not appear in it at all). Both
# make it easy to deploy this lab's metadata into someone else's org, so
# pass this value rather than trusting a default or a listing.
SF_TARGET_ORG=
# External Client App, client-credentials flow. Scopes are per-caller since
# F3/F6 (D37): the agent callers carry chatbot_api + sfap_api only; the obs
# harvest identity additionally keeps api for Data Cloud DMO reads. See
# plan/04-runbooks.md
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# 18-char Id of the published A2ALab service agent (Agent API requires a
# custom Service-type agent, published + active)
SF_AGENT_ID=

# ---- Observability harvest credentials (M11) ------------------------------
# ARN of the `a2alab/obs/harvest` secret — the single source of truth for the
# harvest's SERVICE identities (Salesforce ECA, the GCP service-account key,
# the Entra service principal, model-vendor keys). Set it and
# scripts/obs_harvest.py authenticates exactly as the hosted Lambda does; its
# values override anything below. Leave unset to run the harvest purely from
# this file. Either way the lab never falls back to an interactive `az login`
# or `gcloud auth` — see src/observability/credentials.py for why.
A2ALAB_HARVEST_SECRET_ARN=

# ---- Bridge / tunnel ------------------------------------------------------
# Shared secret Salesforce sends the bridge (External Credential header).
BRIDGE_TOKEN=
# Shared secret for every OTHER tunnel-exposed app (claude-* protocol
# servers, shims, console /api/*). REQUIRED before running the tunnel —
# unset means those endpoints accept unauthenticated requests. Clients pick
# it up via config/targets.yaml. It is a SERVICE credential only: browsers
# sign in as a persona and carry a lab JWT in a header instead (D36 removed
# the ?token= query form, and D38 forbids this token from approving anything).
A2ALAB_TOKEN=
# UNUSED as of 2026-07-27 (scripts/env_audit.py): nothing reads this. The
# cloudflared ingress in deploy/tunnel/config.yml lists its hostnames
# literally, so this was superseded rather than wired up. Commented out
# rather than deleted — restore it if something turns out to need it.
#TUNNEL_HOSTNAME=bridge-lab.agenticthings.com

# WS13 — the console on Fargate behind the bridge's ALB
# (deploy/console/deploy_console.sh). The hostname the ALB routes to this
# service; DNS is cut over separately and reversibly.
#CONSOLE_HOSTNAME=console-lab.example.com
# Listener rule priority on the shared 443 listener. Low numbers match first;
# the bridge is the default action and has no rule, so any free value works.
#CONSOLE_RULE_PRIORITY=20



# ---- OpenAI (M9) ----------------------------------------------------------
OPENAI_API_KEY=

# ---- AWS / AgentCore (M8) -------------------------------------------------
# The SSO profile for the lab's runtime account. Account ids and profile names
# are deliberately not in the repo (see .a2alab/accounts.md), so they live here.
AWS_PROFILE=
AWS_REGION=us-east-1
# The account every deploy MUST land in. deploy/aws_preflight.sh compares the
# live session against it and refuses to create anything on a mismatch — the
# guard against a forgotten AWS_PROFILE quietly deploying the lab into a
# personal account. Leave it unset and deploys still run, but print the account
# they are about to use instead of verifying it.
A2ALAB_AWS_ACCOUNT_ID=

# ---- Lab internals --------------------------------------------------------
A2ALAB_TRACE_DIR=traces
# Trace sinks (ADR D13/D19/D23): jsonl | sqlite | dynamodb | postgres,
# comma-separated. Default jsonl,sqlite — JSONL is the raw archive,
# traces/lab.db is the console's query path (also holds the M11
# observability tables). postgres is the hosted Aurora store (D23);
# dynamodb is superseded but runnable (`uv sync --extra aws`, runbooks §6).
#A2ALAB_TRACE_SINK=jsonl,sqlite
#A2ALAB_TRACE_TABLE=a2alab-traces
#A2ALAB_TRACE_TTL_DAYS=14

# D23 hosted obs store (Aurora Postgres, runbooks §8). Data API pair (needs
# AWS creds; secret ARN picks the DB role — reader for console reads) OR a
# direct DSN. A2ALAB_OBS_STORE=postgres points obs_harvest at Aurora.
#A2ALAB_PG_CLUSTER_ARN=arn:aws:rds:us-east-1:...:cluster:a2alab-obs
#A2ALAB_PG_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:a2alab/obs/reader-...
#A2ALAB_PG_DSN=postgres://lab_writer:...@a2alab-obs.cluster-....rds.amazonaws.com:5432/a2alab
# DDL only (scripts/pg_migrate.py). The RDS-managed master secret, because the
# tables are owned by the master role and lab_writer gets "must be owner of
# table" — which is how the WS12 `kind` column stayed unapplied for a day (D46).
# Find it: aws rds describe-db-clusters --db-cluster-identifier a2alab-obs \
#            --query 'DBClusters[0].MasterUserSecret.SecretArn' --output text
#A2ALAB_PG_MASTER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:rds!cluster-...
#A2ALAB_OBS_STORE=sqlite
#A2ALAB_ANALYST_MODEL=claude-sonnet-5
# The weekly cost sentinel (WS12) — same deployment shape as the analyst above,
# reading the same store through the same obs MCP server, writing briefs to the
# same table with kind='cost'. Model override only; ids live in .a2alab.
#A2ALAB_SENTINEL_MODEL=claude-sonnet-5
# Coding-agent telemetry (WS9). The window the PromQL range query covers, extra
# metric names to try, and repo-label rewrites. The aliases are for mislabels
# the placeholder rule cannot infer (`<owner>/x` already folds into the real
# repo of that name) — CloudWatch cannot delete datapoints, so every correction
# is applied on the read side.
#A2ALAB_CODING_WINDOW_DAYS=7
#A2ALAB_CODING_METRICS=codex.some.new.metric
#A2ALAB_CODING_REPO_ALIASES=old/name=new/name,typo=owner/repo
# Details-tab component links (optional override). Each has a working default in
# console/app.py; set one only to deep-link past a vendor console's landing page.
# FOUNDRY_CONSOLE_URL is the one worth setting — Microsoft documents the portal
# root only, so the per-project link has to be pasted from the browser.
#CLAUDE_AGENT_CONSOLE_URL=https://platform.claude.com/workspaces/default/agents
#OPENAI_CONSOLE_URL=https://platform.openai.com/traces
#FOUNDRY_CONSOLE_URL=https://ai.azure.com/foundryProject/overview?wsid=...
#AGENT_ENGINE_CONSOLE_URL=https://console.cloud.google.com/vertex-ai/agents/agent-engines
#AGENTCORE_CONSOLE_URL=https://us-east-1.console.aws.amazon.com/bedrock-agentcore/home
# Runbook 4 (action-timeout measurement): artificial delay in seconds the
# bridge adds before forwarding — leave unset/0 normally.
#A2ALAB_DELAY_S=0

# ---- Async account-brief pattern (D16) ------------------------------------
# Model for the long-running daily research agent (quality over latency —
# this path has no timeout budget to fit).
CLAUDE_BRIEF_MODEL=claude-sonnet-5
# Accounts the daily brief covers (comma/and-separated, passed verbatim)
A2ALAB_BRIEF_ACCOUNTS='Apple Inc.'
# Anthropic scheduled-deployment cron (fires on Anthropic's side)
A2ALAB_BRIEF_CRON=0 6 * * *
A2ALAB_BRIEF_TZ=America/Denver
# Cap on one research session (seconds)
A2ALAB_BRIEF_TIMEOUT_S=1800
# Who gets the in-app alert (defaults to active System Administrators)
#SF_ALERT_USERNAME=

# ---- OpenAI platform (M9/D24/D25) ----------------------------------------
# Backend for the OpenAI research agent: agents-sdk (real, needs
# OPENAI_API_KEY) or stub (deterministic, no network)
#OPENAI_BACKEND=agents-sdk
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5-mini
#OPENAI_ANSWER_TIMEOUT_S=40
# OpenAI-paired Agentforce twin (ADR D25): the openai agent asks THIS
# agent; its external-research action targets openai-rest (never Claude)
#SF_OPENAI_AGENT_ID=

# ---- AWS AgentCore hosting (M8/M9/D26) ------------------------------------
# Runtime ARNs printed by deploy/agentcore/deploy.sh <platform>
#OPENAI_AGENTCORE_ARN=
#CLAUDE_AGENTCORE_ARN=
# Deployment mode (D26) — where Salesforce-originated delegations land.
# Only affects requests pinned to claude-rest / openai-rest (the Agentforce
# twins' actions, resolved via the bridge; see modes: in targets.yaml):
#   local  = bridge routes to the local servers (:8001 / :8011)
#   hosted = bridge remaps to the AgentCore runtimes (IAM/boto3, needs a
#            live `aws sso login`)
# Scenarios naming an agentcore target explicitly always hit AWS regardless;
# matrix.py cells always measure the exact target they name. Restart the
# stack after flipping — clients are cached per name.
#A2ALAB_MODE=local

# Runtimes write hops through the writer role (deploy.sh maps this over
# A2ALAB_PG_SECRET_ARN in container env; local keeps the reader)
#A2ALAB_PG_WRITER_SECRET_ARN=

# Per-caller Salesforce identity (F6) — optional. Each hosted seam can hold
# its own External Client App so Salesforce login history attributes calls
# per caller instead of pooling them under one integration app. Set the pair
# for a seam and its deploy script ships THAT app in the seam's runtime
# secret; leave unset and the shared SF_CLIENT_ID/SECRET above is used.
# Apps (prod org): a2a_lab_claude / a2a_lab_openai / a2a_lab_shim scoped to
# Chatbot+SFApiPlatform (Agent API only), a2a_lab_obs scoped to Api (the
# Data Cloud DMO reads). Consumer secrets come from Setup → App Manager.
#SF_CLIENT_ID_CLAUDE=
#SF_CLIENT_SECRET_CLAUDE=
#SF_CLIENT_ID_OPENAI=
#SF_CLIENT_SECRET_OPENAI=
#SF_CLIENT_ID_SHIM=
#SF_CLIENT_SECRET_SHIM=
# The harvest reads this pair directly (observability/salesforce_source.py),
# so local harvests attribute as a2a_lab_obs too — no deploy step involved.
#SF_CLIENT_ID_OBS=
#SF_CLIENT_SECRET_OBS=

# Hosted credentials (F1) — NOT a local setting. The deploy scripts move the
# API keys, SF_CLIENT_ID/SF_CLIENT_SECRET and the shim token out of the local
# .env into a2alab/runtime/{claude,openai,shim} in Secrets Manager and set
# this ARN on the runtime/function; interop.secret_env loads it at container
# start. Unset locally (this file stays the source), so it is a no-op here.
#A2ALAB_RUNTIME_SECRET_ARN=

# Delegation guard (D27): max onward-delegation depth a seam will forward
# (default 1 — a delegated-to agent answers itself). Riders + metadata
# carry the depth; see src/interop/delegation.py.
#A2ALAB_MAX_DELEGATION_DEPTH=1

# ---- GCP / ADK (WS2) -------------------------------------------------------
# Dedicated lab project (personal account; Agent Engine free tier covers
# lab volume — see plan/07-workstreams.md WS2)
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=us-central1
#GOOGLE_GENAI_USE_VERTEXAI=TRUE
#ADK_MODEL=gemini-2.5-flash-lite
# ADK researcher's market-signals source. Unset/0 (default): the
# deterministic, clearly-labeled synthetic search_industry_news tool —
# repeatable demo runs, no grounding latency, no per-query billing.
# 1: live Google Search grounding instead (GoogleSearchTool with
# bypass_multi_tools_limit=True). Nondeterministic answers, adds latency
# to an already 30s+ direct-route turn, and grounded queries bill per
# request on the lab's GCP project. Redeploy the engine after flipping:
# uv run python deploy/adk/deploy_adk.py
#ADK_REAL_SEARCH=0
# Agent Engine deployment id + its native A2A endpoint (from the WS2 deploy)
#ADK_AGENT_ENGINE_ID=
#ADK_A2A_ENDPOINT=
# ADK-paired Agentforce twin (D25)
#SF_ADK_AGENT_ID=

# ---- Hosted Agentforce A2A shim (D28) --------------------------------------
# Written by deploy/shim/deploy_shim.sh — the a2a-shim channel endpoint the
# ask_agentforce_a2a tools call (API Gateway + Lambda; app auth x-lab-token)
#AF_SHIM_A2A_URL=
# Client timeout for shim calls. Keep it just under API Gateway's hard 29s
# ceiling: a doomed attempt then fails fast and the tool's single retry
# still fits a hosted runtime's interior budget (measured 2026-07-20: a
# 34s wait + 26s retry + model turns = 73s interior, blowing the old 65s
# invoke timeout).
#AF_SHIM_TIMEOUT_S=28

# ---- Azure / Foundry (WS3) -------------------------------------------------
# Foundry project overview page -> endpoint; shaped like
# https://<resource>.services.ai.azure.com/api/projects/<project-name>
#AZURE_FOUNDRY_PROJECT_ENDPOINT=
# Subscription id (az account show --query id -o tsv)
#AZURE_SUBSCRIPTION_ID=
#AZURE_RESOURCE_GROUP=a2a-lab
# Model deployment NAME (create it as Global Standard pay-per-token —
# never Provisioned/PTU; model choice decided at build time)
#AZURE_FOUNDRY_MODEL_DEPLOYMENT=
# Foundry-paired Agentforce twin (D25) — set after the twin is published
#SF_FOUNDRY_AGENT_ID=
# Log Analytics workspace id (customerId) behind the App Insights resource
# connected to the Foundry project — the foundry obs source queries it (KQL)
#AZURE_LOGS_WORKSPACE_ID=

# Lab Guide (D35) — console docent + REST/MCP/A2A agent on :8031-:8033
# GUIDE_MODEL=claude-haiku-4-5        # falls back to CLAUDE_AGENT_MODEL
# GUIDE_CHAT_HISTORY=10               # past chats kept in the console drawer

# WS6 U1 — lab identity provider (users in config/users.yaml)
# A2ALAB_JWT_DIR=.a2alab          # keypair location (auto-generated)
# A2ALAB_JWT_TTL_S=28800          # lab JWT lifetime (8h default)

# D36 — public console login: per-ROLE passwords (hand out the viewer one;
# the lab token itself never reaches a browser). Unset = that role cannot
# sign in (fail closed).
# A2ALAB_OPERATOR_PASSWORD=
# A2ALAB_VIEWER_PASSWORD=

# ==========================================================================
# Added 2026-07-27 by scripts/env_audit.py — every variable the code reads.
# The rule (CLAUDE.md): .env and .env.example carry the SAME key list. This
# file holds the documentation, .env holds the values. Commented-out lines
# below are optional knobs with working defaults in code.
# ==========================================================================

# ---- ADK / Vertex AI Agent Engine (WS2) --------------------------
# OIDC audience the ADK container mints tokens for (GCP->AWS federation, D40)
#A2ALAB_ADK_AWS_AUDIENCE=
# AWS role the ADK orchestrator assumes for its AgentCore leg (D40)
#A2ALAB_ADK_AWS_ROLE_ARN=
# set to 1 to silence ADK's OTel exporter in the Agent Engine container
#A2ALAB_ADK_DISABLE_OTEL=
# CA bundle for the ADK container's outbound TLS
#AGENT_GATEWAY_ROOT_CERTIFICATES=

# ---- Bedrock AgentCore runtimes (D26) ----------------------------
# which AgentCore runtime a deploy targets (claude|openai)
#A2ALAB_PLATFORM=
# execution role for the AgentCore runtimes (D26)
#AGENTCORE_ROLE_ARN=

# ---- Hosted bridge — ECS Fargate (WS7 item 7) --------------------
# workload-identity audience the hosted bridge presents to GCP
#A2ALAB_BRIDGE_GCP_AUDIENCE=
# GCP service account the bridge task impersonates
#A2ALAB_BRIDGE_GCP_SA=

# ---- Daily brief watcher (D16) -----------------------------------
# poll interval for the daily-brief watcher (D16)
#A2ALAB_BRIEF_POLL_S=

# ---- Target endpoints resolved by config/targets.yaml ------------
# A2A endpoint of the logistics fan-out leg on Agent Engine
#ADK_LOGISTICS_A2A_ENDPOINT=
# A2A endpoint of the ADK orchestrator variant (WS8)
#ADK_ORCHESTRATOR_A2A_ENDPOINT=

# ---- Lab console -------------------------------------------------
# where the console sends Path A runs; defaults to localhost:8100
#A2ALAB_BRIDGE_URL=
# branch the console's Architecture page links source files on
#A2ALAB_REPO_BRANCH=
# public repo the Architecture page links to
#A2ALAB_REPO_URL=

# ---- Fan-out MCP server (D41) ------------------------------------
# workload-identity audience for the fan-out Lambda (D41)
#A2ALAB_FANOUT_GCP_AUDIENCE=
# GCP service account the fan-out Lambda impersonates (D41)
#A2ALAB_FANOUT_GCP_SA=
# bearer token the fan-out MCP server requires (D41)
#A2ALAB_FANOUT_MCP_TOKEN=

# ---- Shared seams ------------------------------------------------
# override config/targets.yaml (tests and alternate registries)
#A2ALAB_TARGETS_PATH=
# public URL an A2A server advertises in its agent card
#A2A_PUBLIC_URL=
# token hosted runtimes present to the Agentforce shim
#AF_SHIM_TOKEN=
# Entra service principal used for Foundry calls (WS3)
#AZURE_CLIENT_ID=
# its secret — expires; watch scripts/expiry_report.py
#AZURE_CLIENT_SECRET=
# Entra tenant the service principal authenticates against
#AZURE_TENANT_ID=

# ---- Observability deploys (D23) ---------------------------------
# service-account key file shipped into the harvest secret
#A2ALAB_GCP_KEY_FILE=
# same, for the observability reader identity
#A2ALAB_GCP_OBS_KEY_FILE=

# ---- Obs MCP server (D23) ----------------------------------------
# bearer token for the hosted obs MCP server (D23)
#A2ALAB_OBS_MCP_TOKEN=

# ---- Observability harvest (M11) ---------------------------------
# how long to wait for the hosted obs analyst run (D23)
#A2ALAB_ANALYST_TIMEOUT_S=
# region for the PromQL client that reads coding-agent metrics
#A2ALAB_CW_REGION=

# ---- Fan-out orchestration (WS8) ---------------------------------
# per-leg cap for fan-out orchestration (kept under the gateway ceiling)
#A2ALAB_LEG_TIMEOUT_S=

# ---- Platform backends -------------------------------------------
# turn cap for the self-hosted claude-agent-sdk backend
#CLAUDE_MAX_TURNS=
# Foundry agent's inbound A2A endpoint (WS3)
#FOUNDRY_A2A_ENDPOINT=
# how long the ADK orchestrator waits on its Foundry leg
#FOUNDRY_A2A_TIMEOUT_S=
# cap on the OpenAI agent's ask_agentforce tool call
#OPENAI_AGENTFORCE_TOOL_TIMEOUT_S=
# output cap for the OpenAI agents-sdk backend (D24)
#OPENAI_MAX_TOKENS=
# turn cap for the same
#OPENAI_MAX_TURNS=
# reasoning effort for the OpenAI agents-sdk backend
#OPENAI_REASONING_EFFORT=

# ---- Operator scripts --------------------------------------------
# region of the CloudWatch OTLP metrics endpoint (WS9)
#A2ALAB_CW_METRICS_REGION=
# Secrets Manager secret holding the CloudWatch metrics API key (WS9)
#A2ALAB_CW_METRICS_SECRET=
# full OTLP metrics URL for Codex; note the required /v1/metrics path
#A2ALAB_CW_OTLP_METRICS_ENDPOINT=
# Secrets Manager secret this .env syncs with (scripts/env_sync.py)
#A2ALAB_ENV_SECRET=
# model for the fan-out orchestrator agent
#A2ALAB_ORCHESTRATOR_MODEL=
# extra OTEL_RESOURCE_ATTRIBUTES appended by scripts/codex_otel.sh
#A2ALAB_OTEL_EXTRA_ATTRS=
# where provisioning state lands; defaults to .a2alab
#A2ALAB_STATE_DIR=
# resolved CloudWatch bearer token (set by otel_headers.sh, not by hand)
#CW_METRICS_TOKEN=

# ---- Agentforce shim (D28) ---------------------------------------
# shim: log inbound headers (never leave on — they carry tokens)
#A2ALAB_DEBUG_HEADERS=
# public URL the hosted shim advertises in its agent card (D28)
#AF_SHIM_PUBLIC_URL=

# ---- Fan-out legs (WS8/D41) ------------------------------------------------
# Which target each business unit's leg calls. Named per unit so a leg can be
# repointed at a different platform without touching orchestration code.
#A2ALAB_LEG_COMMERCIAL_TARGET=
#A2ALAB_LEG_COMMS_TARGET=
#A2ALAB_LEG_EXPOSURE_TARGET=
# Agent Engine deployment ids for the fan-out legs, printed by
# deploy/adk/deploy_adk.py. The A2A endpoints above are derived from these.
#ADK_LOGISTICS_ENGINE_ID=
#ADK_ORCHESTRATOR_ENGINE_ID=

# IAM user holding the CloudWatch metrics API key (WS9) — expiry_report.py
# reads that key's expiry date from IAM.
#A2ALAB_CW_METRICS_USER=
