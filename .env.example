# ---- Anthropic (Claude agent) -------------------------------------------
ANTHROPIC_API_KEY=
# Claude hosting backend: managed (Anthropic Managed Agents beta, default)
# or sdk (self-hosted claude-agent-sdk)
CLAUDE_BACKEND=managed
# Managed Agents IDs — written by scripts/setup_managed_agent.py into
# .a2alab/managed.json; set here only to override.
#CLAUDE_MANAGED_AGENT_ID=
#CLAUDE_MANAGED_ENV_ID=

# WS13 item 3 — the hosted brief watcher (deploy/briefs/deploy_briefs.sh).
# These normally live in .a2alab/brief.json, written by
# scripts/setup_brief_agent.py. A container has no .a2alab, and they are
# configuration rather than secrets, so the environment wins when set.
#A2ALAB_BRIEF_DEPLOYMENT_ID=
#A2ALAB_BRIEF_AGENT_ID=
#A2ALAB_BRIEF_ENV_ID=
# Poll interval for the watcher; sessions idle safely between polls.
#A2ALAB_BRIEF_POLL_S=60
# Model for the research agent (Haiku-tier keeps Path A inside the
# Agentforce action timeout budget; A/B a Sonnet-tier later)
CLAUDE_AGENT_MODEL=claude-haiku-4-5
# Cap on one Claude answer. Needs headroom for Claude -> Agentforce (an
# Agent API round trip runs INSIDE Claude's turn, plus managed-session cold
# start). Agentforce -> Claude is governed by the tighter upstream chain
# regardless (bridge client 45s -> Apex 110s -> Agentforce action ~85-90s,
# MEASURED 2026-07-25 — this comment said ~60s until 2026-07-28, the reported
# figure the lab engineered against for six weeks without testing).
CLAUDE_ANSWER_TIMEOUT_S=100

# ---- Salesforce / Agentforce ---------------------------------------------
# My Domain host of the production org, e.g. mycompany.my.salesforce.com
SF_MY_DOMAIN=
# sf CLI alias for THIS org — the one every `sf`/DX MCP call must target.
# Named explicitly because the CLI's global `target-org` default belongs to
# whatever project was touched last, and the DX MCP server lists only an
# allow-listed subset of orgs (the lab's may not appear in it at all). Both
# make it easy to deploy this lab's metadata into someone else's org, so
# pass this value rather than trusting a default or a listing.
SF_TARGET_ORG=
# External Client App, client-credentials flow. Scopes are per-caller since
# F3/F6 (D37): the agent callers carry chatbot_api + sfap_api only; the obs
# harvest identity additionally keeps api for Data Cloud DMO reads. See
# plan/04-runbooks.md
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# 18-char Id of the published A2ALab service agent (Agent API requires a
# custom Service-type agent, published + active)
SF_AGENT_ID=

# ---- Observability harvest credentials (M11) ------------------------------
# ARN of the `a2alab/obs/harvest` secret — the single source of truth for the
# harvest's SERVICE identities (Salesforce ECA, the GCP service-account key,
# the Entra service principal, model-vendor keys). Set it and
# scripts/obs_harvest.py authenticates exactly as the hosted Lambda does; its
# values override anything below. Leave unset to run the harvest purely from
# this file. Either way the lab never falls back to an interactive `az login`
# or `gcloud auth` — see src/observability/credentials.py for why.
A2ALAB_HARVEST_SECRET_ARN=
# The scheduled harvest Lambda. Its PRESENCE is what makes the console's
# Harvest button asynchronous (D54): a full six-platform sweep runs past the
# ALB's 120s idle timeout, so the console fires this function and polls the
# store instead of holding the request open. Unset on a laptop, where the
# sweep runs in-process because nothing is timing it out. Set by
# deploy/console/deploy_console.sh, which defaults it to a2alab-obs-harvest.
#A2ALAB_HARVEST_FUNCTION=a2alab-obs-harvest

# ---- Bridge / tunnel ------------------------------------------------------
# Shared secret Salesforce sends the bridge (External Credential header).
BRIDGE_TOKEN=
# Shared secret for every OTHER tunnel-exposed app (claude-* protocol
# servers, shims, console /api/*). REQUIRED before running the tunnel —
# unset means those endpoints accept unauthenticated requests. Clients pick
# it up via config/targets.yaml. It is a SERVICE credential only: browsers
# sign in as a persona and carry a lab JWT in a header instead (D36 removed
# the ?token= query form, and D38 forbids this token from approving anything).
A2ALAB_TOKEN=
# UNUSED as of 2026-07-27 (scripts/env_audit.py): nothing reads this. The
# cloudflared ingress in deploy/tunnel/config.yml lists its hostnames
# literally, so this was superseded rather than wired up. Commented out
# rather than deleted — restore it if something turns out to need it.
#TUNNEL_HOSTNAME=bridge-lab.agenticthings.com

# WS13 — the console on Fargate behind the bridge's ALB
# (deploy/console/deploy_console.sh). The hostname the ALB routes to this
# service; DNS is cut over separately and reversibly.
#CONSOLE_HOSTNAME=console-lab.example.com
# Listener rule priority on the shared 443 listener. Low numbers match first;
# the bridge is the default action and has no rule, so any free value works.
#CONSOLE_RULE_PRIORITY=20
# Port for scripts/run_console.sh, the console-only dev loop. Handy when 8200
# is taken; the deployed console always listens on 8200 inside its container.
#CONSOLE_PORT=8200
# Auto-reload the console on Python changes in the dev loop (default on).
# index.html is read per request so HTML edits are instant; src/**.py is
# imported once, so without this an edited endpoint keeps serving old code.
#CONSOLE_RELOAD=1
# Which console scripts/demo_watch.py warms before a live run (plan/10). Defaults
# to the local console; point it at the hosted console to warm that instead.
#A2ALAB_CONSOLE_URL=http://localhost:8200
# WS13 item 2 — the nine protocol faces on Fargate
# (deploy/faces/deploy_faces.sh). ONE hostname serves all of them, addressed
# by path: https://<FACES_HOSTNAME>/<target-name>/... So this is one DNS
# record, one target group and one listener rule, not nine of each.
#FACES_HOSTNAME=faces-lab.example.com
#FACES_RULE_PRIORITY=30
# Origin of the hosted faces. TWO consumers, deliberately one variable:
# config/targets.yaml expands it for the `*-hosted` twins, and the faces app
# gives it to the A2A cards as the URL they advertise. A card pointing
# somewhere clients are not sent fails only on the call BACK.
#A2ALAB_FACES_BASE=https://faces-lab.example.com

# ---- LangGraph on Heroku (WS4/D77) ----------------------------------------
# The lab's first non-AWS host. The agent brain reuses ANTHROPIC_API_KEY;
# LANGGRAPH_BACKEND=langgraph selects the real backend (stub is the default).
#LANGGRAPH_BACKEND=langgraph
#LANGGRAPH_MODEL_ID=claude-haiku-4-5-20251001
# Answer timeout. On Heroku the console/bridge drive the dyno over A2A
# fire-then-poll (WS4/D77), so no single request hits the 30s H12 router ceiling
# and this can exceed 30s. Keep it below A2ALAB_ASYNC_LEG_TIMEOUT_S (default 120)
# so a stuck answer fails before the poll loop does. 90 is a good default.
#LANGGRAPH_ANSWER_TIMEOUT_S=90
#LANGGRAPH_AGENTFORCE_TOOL_TIMEOUT_S=34
# PORT is INJECTED by the host at runtime (Heroku/containers) — never set it
# here; documented only so the env contract knows the code reads it as a
# fallback when --port is not passed (src/platforms/langgraph, src/faces).
#PORT=
# The Heroku app origin — config/targets.yaml expands it for the langgraph-*-
# hosted twins, and the A2A card advertises it (same dual use as FACES_BASE).
#A2ALAB_LANGGRAPH_BASE=https://a2a-lab-langgraph.herokuapp.com
# The D25 LangGraph-paired Agentforce twin the agent's ask_agentforce consults.
#SF_LANGGRAPH_AGENT_ID=
# Heroku deploy (deploy/heroku/deploy_langgraph.sh) — no identifier hardcoded.
# The API token is secret-shaped (synced via env_sync). HEROKU_SPACE only for
# a Heroku Enterprise Private Space.
#HEROKU_APP=a2a-lab-langgraph
#HEROKU_TEAM=
#HEROKU_API_KEY=
#HEROKU_SPACE=
# Off-AWS trace sink (WS4 item 9): the Heroku dyno has no IAM role, so it writes
# traces to the shared Aurora over the Data API with a STATIC scoped access key.
# Dedicated names (not AWS_*) so `source .env` cannot shadow the operator's SSO
# locally; deploy_langgraph.sh maps them to AWS_ACCESS_KEY_ID/SECRET in the
# pushed config ONLY, sets A2ALAB_PG_SECRET_ARN to the writer secret, and
# defaults A2ALAB_TRACE_SINK=postgres. Synced via env_sync (secret-shaped).
#A2ALAB_HEROKU_AWS_ACCESS_KEY_ID=
#A2ALAB_HEROKU_AWS_SECRET_ACCESS_KEY=
# LangSmith observability (host-agnostic; WS4 item 7). LangSmith is LangGraph's
# framework-native trace surface: with the API key + tracing on, the app emits
# its run tree with zero code, and the obs harvest reads it back (langgraph
# source). The key is the lab's own personal-account key (the GCP/Azure pattern
# for non-Salesforce platforms). LANGSMITH_ENDPOINT defaults to the SaaS URL.
#LANGSMITH_API_KEY=
#LANGCHAIN_TRACING_V2=true
#LANGCHAIN_PROJECT=a2a-lab
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com



# ---- OpenAI (M9) ----------------------------------------------------------
OPENAI_API_KEY=

# ---- AWS / AgentCore (M8) -------------------------------------------------
# The SSO profile for the lab's runtime account. Account ids and profile names
# are deliberately not in the repo (see .a2alab/accounts.md), so they live here.
AWS_PROFILE=
AWS_REGION=us-east-1
# The account every deploy MUST land in. deploy/aws_preflight.sh compares the
# live session against it and refuses to create anything on a mismatch — the
# guard against a forgotten AWS_PROFILE quietly deploying the lab into a
# personal account. Leave it unset and deploys still run, but print the account
# they are about to use instead of verifying it.
A2ALAB_AWS_ACCOUNT_ID=

# ---- Jira delivery record (WS15 / D58) ------------------------------------
# The board is the delivery view; plan/07-workstreams.md stays the source of
# truth for scope and plan/00-decisions.md for reasoning. The API token is a
# credential like any other (D39): here and in Secrets Manager, never in the
# repo.
#
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
# (there is no id.atlassian.com -> Security -> API tokens nav path; go direct).
# It must be a USER API token. An ORGANIZATION admin key was tried first and
# does not work here: it authenticates to the org admin API, not to Jira's
# issue API, and it carries far more authority than writing issues needs.
#
# JIRA_PROJECT_KEY is correct despite the UI: Jira now calls the container a
# SPACE, while the REST API and JQL still say `project` (/rest/api/3/project,
# `project = A2A`). Field names follow the API, not the UI.
#JIRA_SITE_URL=https://your-site.atlassian.net
#JIRA_PROJECT_KEY=A2A
#JIRA_EMAIL=
#JIRA_API_TOKEN=

# ---- Lab internals --------------------------------------------------------
A2ALAB_TRACE_DIR=traces
# Trace sinks (ADR D13/D19/D23): jsonl | sqlite | dynamodb | postgres,
# comma-separated. Default jsonl,sqlite — JSONL is the raw archive,
# traces/lab.db is the console's query path (also holds the M11
# observability tables). postgres is the hosted Aurora store (D23);
# dynamodb is superseded but runnable (`uv sync --extra aws`, runbooks §6).
#A2ALAB_TRACE_SINK=jsonl,sqlite
#A2ALAB_TRACE_TABLE=a2alab-traces
#A2ALAB_TRACE_TTL_DAYS=14

# D23 hosted obs store (Aurora Postgres, runbooks §8). Data API pair (needs
# AWS creds; secret ARN picks the DB role — reader for console reads) OR a
# direct DSN. A2ALAB_OBS_STORE=postgres points obs_harvest at Aurora.
#A2ALAB_PG_CLUSTER_ARN=arn:aws:rds:us-east-1:...:cluster:a2alab-obs
#A2ALAB_PG_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:a2alab/obs/reader-...
#A2ALAB_PG_DSN=postgres://lab_writer:...@a2alab-obs.cluster-....rds.amazonaws.com:5432/a2alab
# Database name for the Data API path; defaults to "a2alab" (pg.py
# DEFAULT_DATABASE), so set it only if the cluster uses a different one.
#A2ALAB_PG_DATABASE=a2alab
# DDL only (scripts/pg_migrate.py). The RDS-managed master secret, because the
# tables are owned by the master role and lab_writer gets "must be owner of
# table" — which is how the WS12 `kind` column stayed unapplied for a day (D46).
# Find it: aws rds describe-db-clusters --db-cluster-identifier a2alab-obs \
#            --query 'DBClusters[0].MasterUserSecret.SecretArn' --output text
#A2ALAB_PG_MASTER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:rds!cluster-...
# Postgres is the source of truth for the observability section (D49).
# Set to sqlite only to work on a harvested snapshot with no AWS session.
#A2ALAB_OBS_STORE=postgres

# WS19/D69: the Data 360 Zero Copy connector's egress region — the DATA CLOUD
# TENANT's region, read from its home-org instance name (CDP2-AWS-PROD<n>-<REGION>
# in Setup -> Data Cloud), NOT the core org's instance and NOT where Aurora
# lives. deploy/obs/deploy_datacloud_ingress.sh looks this up in
# config/salesforce_ip_ranges.yaml to build the 5432 allowlist. Kept in .env
# because it identifies the tenant's location; the CIDRs themselves are public.
# The lab's tenant is CDP2-AWS-PROD3-EUCENTRAL1 (eu-central-1, co-located with
# the EU55 org). Confirm your own before pinning — a wrong region silently
# allowlists IPs the probe never uses (D70).
#A2ALAB_DATACLOUD_REGION=eu-central-1
# The Aurora cluster whose SG the ingress rule is added to. Defaults to the
# obs cluster identifier the runbooks name; set only if it differs.
#A2ALAB_PG_CLUSTER_ID=a2alab-obs
#A2ALAB_ANALYST_MODEL=claude-sonnet-5
# ---- Track B: cross-cloud infrastructure metrics (Moirai exploration) -----
# The SRE-grade RUNTIME telemetry harvest — the sibling of the agent-log
# harvest above, written to lab.infra_metrics as a dense regular time grid.
# Series live in config/infra_metrics.yaml; these resolve the ${VAR}s it uses.
# Opt-in: `uv run python scripts/obs_harvest.py infra` (or one infra-* source).
# The two Fargate services + the Aurora cluster the CloudWatch series read. The
# cluster identifier reuses A2ALAB_PG_CLUSTER_ID (above); the ECS cluster and
# the two service names are named here — no literal lives in the yaml.
#A2ALAB_ECS_CLUSTER=a2alab
#A2ALAB_CONSOLE_SERVICE=a2alab-console
#A2ALAB_BRIDGE_SERVICE=a2alab-bridge
# The Foundry project's ARM resource id, the Azure Monitor series' resource_uri.
# Names the subscription + resource group + resource, so it belongs in .env, not
# the repo (the account-identifier rule). Read from the Azure portal or
# `az resource show`. Foundry runtime metrics are skipped (blocked) when unset.
#AZURE_FOUNDRY_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/...
# Override the series file location (defaults to config/infra_metrics.yaml).
#A2ALAB_INFRA_METRICS_PATH=config/infra_metrics.yaml
# The weekly cost sentinel (WS12) — same deployment shape as the analyst above,
# reading the same store through the same obs MCP server, writing briefs to the
# same table with kind='cost'. Model override only; ids live in .a2alab.
#A2ALAB_SENTINEL_MODEL=claude-sonnet-5
# Coding-agent telemetry (WS9). The window the PromQL range query covers, extra
# metric names to try, and repo-label rewrites. The aliases are for mislabels
# the placeholder rule cannot infer (`<owner>/x` already folds into the real
# repo of that name) — CloudWatch cannot delete datapoints, so every correction
# is applied on the read side.
#A2ALAB_CODING_WINDOW_DAYS=7
#A2ALAB_CODING_METRICS=codex.some.new.metric
#A2ALAB_CODING_REPO_ALIASES=old/name=new/name,typo=owner/repo
# Behavioural logs (WS16/D59, coding_logs_source.py). The window the
# FilterLogEvents read covers; defaults to A2ALAB_CODING_WINDOW_DAYS then 7.
#A2ALAB_CODING_LOGS_WINDOW_DAYS=7
# Details-tab component links (optional override). Each has a working default in
# console/app.py; set one only to deep-link past a vendor console's landing page.
# FOUNDRY_CONSOLE_URL is the one worth setting — Microsoft documents the portal
# root only, so the per-project link has to be pasted from the browser.
#CLAUDE_AGENT_CONSOLE_URL=https://platform.claude.com/workspaces/default/agents
#OPENAI_CONSOLE_URL=https://platform.openai.com/traces
#FOUNDRY_CONSOLE_URL=https://ai.azure.com/foundryProject/overview?wsid=...
#AGENT_ENGINE_CONSOLE_URL=https://console.cloud.google.com/vertex-ai/agents/agent-engines
#AGENTCORE_CONSOLE_URL=https://us-east-1.console.aws.amazon.com/bedrock-agentcore/home
# Runbook 4 (action-timeout measurement): artificial delay in seconds the
# bridge adds before forwarding — leave unset/0 normally.
#A2ALAB_DELAY_S=0

# ---- Async account-brief pattern (D16) ------------------------------------
# Model for the long-running daily research agent (quality over latency —
# this path has no timeout budget to fit).
CLAUDE_BRIEF_MODEL=claude-sonnet-5
# Accounts the daily brief covers (comma/and-separated, passed verbatim)
A2ALAB_BRIEF_ACCOUNTS='Apple Inc.'
# Anthropic scheduled-deployment cron (fires on Anthropic's side)
A2ALAB_BRIEF_CRON=0 6 * * *
A2ALAB_BRIEF_TZ=America/Denver
# Cap on one research session (seconds)
A2ALAB_BRIEF_TIMEOUT_S=1800
# Who gets the in-app alert (defaults to active System Administrators)
#SF_ALERT_USERNAME=

# ---- OpenAI platform (M9/D24/D25) ----------------------------------------
# Backend for the OpenAI research agent: agents-sdk (real, needs
# OPENAI_API_KEY) or stub (deterministic, no network)
#OPENAI_BACKEND=agents-sdk
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5-mini
#OPENAI_ANSWER_TIMEOUT_S=40
# OpenAI-paired Agentforce twin (ADR D25): the openai agent asks THIS
# agent; its external-research action targets openai-rest (never Claude)
#SF_OPENAI_AGENT_ID=

# ---- AWS Strands agent (WS5/D66) ------------------------------------------
# Backend for the Strands research agent: strands-sdk (real; Kiro's
# deliverable, plan/12-strands-kiro-handoff.md) or stub (deterministic, no
# network — the default until Kiro delivers). Strands runs its model on
# Amazon Bedrock via the AgentCore runtime's IAM role, so there is NO model
# API key here (the framework-isolation choice — same cloud/model family as
# the Claude runtime, only the SDK differs).
#STRANDS_BACKEND=strands-sdk
# Bedrock model id the Strands agent invokes (Kiro pins the exact id in its
# handback; a Claude-on-Bedrock inference-profile id keeps WS5 a clean
# framework-only comparison against the Claude AgentCore twin)
#STRANDS_MODEL_ID=
#STRANDS_ANSWER_TIMEOUT_S=40
# Cap on the Strands agent's ask_agentforce tool call (seconds)
#STRANDS_AGENTFORCE_TOOL_TIMEOUT_S=34
# Cap on the Strands agent's cross-hyperscaler Google ADK consult (seconds),
# BOTH routes: ask_google_adk (native-direct) and ask_google_adk_bridge (WS5)
#STRANDS_ADK_TIMEOUT_S=65
# Strands-paired Agentforce twin (ADR D25): the strands agent asks THIS
# agent; its external-research action targets strands-rest (never
# Claude/OpenAI)
#SF_STRANDS_AGENT_ID=

# ---- AWS AgentCore hosting (M8/M9/D26) ------------------------------------
# Runtime ARNs printed by deploy/agentcore/deploy.sh <platform>
#OPENAI_AGENTCORE_ARN=
#CLAUDE_AGENTCORE_ARN=
# Strands runtime ARN (WS5) — unset until deploy/agentcore/deploy.sh strands
# creates the runtime, which waits on Kiro's backend (targets.yaml marks the
# strands-agentcore cell blocked-beta until then)
#STRANDS_AGENTCORE_ARN=
# Deployment mode (D26) — where Salesforce-originated delegations land.
# Only affects requests pinned to claude-rest / openai-rest (the Agentforce
# twins' actions, resolved via the bridge; see modes: in targets.yaml):
#   local  = bridge routes to the local servers (:8001 / :8011)
#   hosted = bridge remaps to the AgentCore runtimes (IAM/boto3, needs a
#            live `aws sso login`)
# Scenarios naming an agentcore target explicitly always hit AWS regardless;
# matrix.py cells always measure the exact target they name. Restart the
# stack after flipping — clients are cached per name.
#A2ALAB_MODE=local

# Runtimes write hops through the writer role (deploy.sh maps this over
# A2ALAB_PG_SECRET_ARN in container env; local keeps the reader)
#A2ALAB_PG_WRITER_SECRET_ARN=

# Console usage analytics (WS18, D62) — the external AWS logging service the
# /api/track proxy forwards to (same custom Lambda + API Gateway used for the
# Claude/Codex hooks). SERVER-side only: the URL and key live here / in Secrets
# Manager and never reach the public bundle, unlike a VITE_-inlined client key.
# Contract: POST {source,level,message,detail} with an X-Api-Key header. Unset
# and the console still stores its own lab.usage_events rows — only the Slack
# forward is skipped. No account identifier goes in the URL you commit.
#A2ALAB_LOGGING_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod/log
#A2ALAB_LOGGING_API_KEY=
# WS9 item 16: auth mode for the /log forward. Default 'apikey' (the X-Api-Key
# above). 'iam' SigV4-signs for execute-api instead (no long-lived key) — only
# after the EXTERNAL API Gateway /log route is switched to AWS_IAM with a
# cross-account resource policy (that half is in the operator's aws-logging-
# service repo, not here). A2ALAB_LOGGING_REGION overrides the SigV4 region
# (else parsed from the execute-api host, else AWS_REGION) — the logger is in a
# different region than the console, so make it explicit when using iam.
#A2ALAB_LOGGING_AUTH=apikey
#A2ALAB_LOGGING_REGION=

# Per-caller Salesforce identity (F6) — optional. Each hosted seam can hold
# its own External Client App so Salesforce login history attributes calls
# per caller instead of pooling them under one integration app. Set the pair
# for a seam and its deploy script ships THAT app in the seam's runtime
# secret; leave unset and the shared SF_CLIENT_ID/SECRET above is used.
# Apps (prod org): a2a_lab_claude / a2a_lab_openai / a2a_lab_shim scoped to
# Chatbot+SFApiPlatform (Agent API only), a2a_lab_obs scoped to Api (the
# Data Cloud DMO reads). Consumer secrets come from Setup → App Manager.
#SF_CLIENT_ID_CLAUDE=
#SF_CLIENT_SECRET_CLAUDE=
#SF_CLIENT_ID_OPENAI=
#SF_CLIENT_SECRET_OPENAI=
#SF_CLIENT_ID_SHIM=
#SF_CLIENT_SECRET_SHIM=
# The harvest reads this pair directly (observability/salesforce_source.py),
# so local harvests attribute as a2a_lab_obs too — no deploy step involved.
#SF_CLIENT_ID_OBS=
#SF_CLIENT_SECRET_OBS=
# WS23/D73: the Agentforce Session Trace OTel API harvest source
# (observability/salesforce_otel_source.py, `obs_harvest.py salesforce-otel`).
# Reuses the a2a_lab_obs ECA above for the token — no new credential. The OTel
# API is single-session (GET .../otel/{session-id}), so the source needs to know
# WHICH sessions to pull: set A2ALAB_OTEL_SESSION_IDS to a comma-separated list
# to pull exactly those, or leave it unset and the source lists recent sessions
# from the DMO and pulls up to A2ALAB_OTEL_MAX_SESSIONS of them (default 25).
# Both optional — unset is a valid config (the source lists then caps). This
# path is built-but-not-live (D73): it is reachable by name but NOT in the
# default obs sweep, which stays on the DMO harvest.
#A2ALAB_OTEL_SESSION_IDS=
#A2ALAB_OTEL_MAX_SESSIONS=25
# WS19/M10: the Tableau Next inline embed (owner-only, console). The console
# mints a frontdoor URL server-side (→ /singleaccess) so the dashboard renders
# in-page with no login step. That exchange needs the `web` scope, which
# Salesforce's client-credentials flow NEVER issues (only `api`, and passing
# scope=web is rejected) — so the console uses the JWT-BEARER flow against this
# ECA (a2a_lab_tab_embed), which runs in the run-as user's context and so carries
# the ECA's `web` grant. Three things are needed: the consumer key (JWT `iss`),
# the run-as username (JWT `sub` — the Tableau-Next-licensed admin, or a dedicated
# integration user), and the RS256 signing key whose public cert is on the ECA.
# Unset → the embed is not offered (the deep link and screenshot still show). No
# consumer secret is used for this seam. The signing key defaults to
# .a2alab/tab_embed_jwt_private.pem locally; hosted, the deploy ships that PEM into
# Secrets Manager as A2ALAB_TAB_EMBED_JWT_KEY (set here only to override the file).
#SF_CLIENT_ID_TAB_EMBED=
#SF_TAB_EMBED_RUNAS_USER=
#A2ALAB_TAB_EMBED_JWT_KEY=
# The JWT `aud` / token host for the embed's JWT-bearer exchange. Defaults to
# https://login.salesforce.com (production); set to https://test.salesforce.com
# for a sandbox. Only the frontdoor mint reads it.
#SF_LOGIN_URL=
# The Tableau Next dashboard's API name (the inline embed target). Defaults
# to New_Dashboard; override only if the dashboard is renamed in the org.
#TABLEAU_DASHBOARD_API_NAME=New_Dashboard
# The in-org custom TAB the "open in Salesforce" deep link points at
# (/lightning/n/<tab>). The tab is an App Builder page that carries the licence +
# asset-share context the runtime needs, so it renders where the raw dashboard
# view can 504. Defaults to A2A_Lab_Traffic; override only if the tab is renamed.
#TABLEAU_APP_TAB=A2A_Lab_Traffic

# Hosted credentials (F1) — NOT a local setting. The deploy scripts move the
# API keys, SF_CLIENT_ID/SF_CLIENT_SECRET and the shim token out of the local
# .env into a2alab/runtime/{claude,openai,shim} in Secrets Manager and set
# this ARN on the runtime/function; interop.secret_env loads it at container
# start. Unset locally (this file stays the source), so it is a no-op here.
#A2ALAB_RUNTIME_SECRET_ARN=

# Delegation guard (D27): max onward-delegation depth a seam will forward
# (default 1 — a delegated-to agent answers itself). Riders + metadata
# carry the depth; see src/interop/delegation.py.
#A2ALAB_MAX_DELEGATION_DEPTH=1

# ---- GCP / ADK (WS2) -------------------------------------------------------
# Dedicated lab project (personal account; Agent Engine free tier covers
# lab volume — see plan/07-workstreams.md WS2)
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=us-central1
#GOOGLE_GENAI_USE_VERTEXAI=TRUE
#ADK_MODEL=gemini-2.5-flash-lite
# ADK researcher's market-signals source. Unset/0 (default): the
# deterministic, clearly-labeled synthetic search_industry_news tool —
# repeatable demo runs, no grounding latency, no per-query billing.
# 1: live Google Search grounding instead (GoogleSearchTool with
# bypass_multi_tools_limit=True). Nondeterministic answers, adds latency
# to an already 30s+ direct-route turn, and grounded queries bill per
# request on the lab's GCP project. Redeploy the engine after flipping:
# uv run python deploy/adk/deploy_adk.py
#ADK_REAL_SEARCH=0
# Agent Engine deployment id + its native A2A endpoint (from the WS2 deploy)
#ADK_AGENT_ENGINE_ID=
#ADK_A2A_ENDPOINT=
# ADK-paired Agentforce twin (D25)
#SF_ADK_AGENT_ID=

# ---- Hosted Agentforce A2A shim (D28) --------------------------------------
# Written by deploy/shim/deploy_shim.sh — the a2a-shim channel endpoint the
# ask_agentforce_a2a tools call (API Gateway + Lambda; app auth x-lab-token)
#AF_SHIM_A2A_URL=
# Client timeout for shim calls. Keep it just under API Gateway's hard 29s
# ceiling: a doomed attempt then fails fast and the tool's single retry
# still fits a hosted runtime's interior budget (measured 2026-07-20: a
# 34s wait + 26s retry + model turns = 73s interior, blowing the old 65s
# invoke timeout).
#AF_SHIM_TIMEOUT_S=28

# ---- Azure / Foundry (WS3) -------------------------------------------------
# Foundry project overview page -> endpoint; shaped like
# https://<resource>.services.ai.azure.com/api/projects/<project-name>
#AZURE_FOUNDRY_PROJECT_ENDPOINT=
# Subscription id (az account show --query id -o tsv)
#AZURE_SUBSCRIPTION_ID=
#AZURE_RESOURCE_GROUP=a2a-lab
# Model deployment NAME (create it as Global Standard pay-per-token —
# never Provisioned/PTU; model choice decided at build time)
#AZURE_FOUNDRY_MODEL_DEPLOYMENT=
# Foundry-paired Agentforce twin (D25) — set after the twin is published
#SF_FOUNDRY_AGENT_ID=
# Log Analytics workspace id (customerId) behind the App Insights resource
# connected to the Foundry project — the foundry obs source queries it (KQL)
#AZURE_LOGS_WORKSPACE_ID=

# Lab Guide (D35) — console docent + REST/MCP/A2A agent on :8031-:8033
# GUIDE_MODEL=claude-haiku-4-5        # falls back to CLAUDE_AGENT_MODEL
# GUIDE_CHAT_HISTORY=10               # past chats kept in the console drawer
# A2ALAB_EXPERIMENT_CHAT_HISTORY=3    # past chats per experiment the Run tab can
                                      # switch back to (this browser session only)

# WS6 U1 — lab identity provider (users in config/users.yaml)
# A2ALAB_JWT_DIR=.a2alab          # keypair location (auto-generated)
# A2ALAB_JWT_TTL_S=28800          # lab JWT lifetime (8h default)

# D36 — public console login: per-ROLE passwords (hand out the viewer one;
# the lab token itself never reaches a browser). Unset = that role cannot
# sign in (fail closed). "master of the universe" is the lab owner's own
# role — same permissions as operator, distinct login so the operator
# password can be shared without sharing the owner's.
# A2ALAB_MASTER_PASSWORD=
# A2ALAB_OPERATOR_PASSWORD=
# A2ALAB_VIEWER_PASSWORD=

# ==========================================================================
# Added 2026-07-27 by scripts/env_audit.py — every variable the code reads.
# The rule (CLAUDE.md): .env and .env.example carry the SAME key list. This
# file holds the documentation, .env holds the values. Commented-out lines
# below are optional knobs with working defaults in code.
# ==========================================================================

# ---- ADK / Vertex AI Agent Engine (WS2) --------------------------
# OIDC audience the ADK container mints tokens for (GCP->AWS federation, D40)
#A2ALAB_ADK_AWS_AUDIENCE=
# AWS role the ADK orchestrator assumes for its AgentCore leg (D40)
#A2ALAB_ADK_AWS_ROLE_ARN=
# set to 1 to silence ADK's OTel exporter in the Agent Engine container
#A2ALAB_ADK_DISABLE_OTEL=
# CA bundle for the ADK container's outbound TLS
#AGENT_GATEWAY_ROOT_CERTIFICATES=

# ---- Bedrock AgentCore runtimes (D26) ----------------------------
# which AgentCore runtime a deploy targets (claude|openai)
#A2ALAB_PLATFORM=
# execution role for the AgentCore runtimes (D26)
#AGENTCORE_ROLE_ARN=

# ---- Hosted bridge — ECS Fargate (WS7 item 7) --------------------
# workload-identity audience the hosted bridge presents to GCP
#A2ALAB_BRIDGE_GCP_AUDIENCE=
# GCP service account the bridge task impersonates
#A2ALAB_BRIDGE_GCP_SA=

# ---- Hosted console — ECS Fargate (WS13 item 1) ------------------
# Same pool, provider and service account as the bridge pair above; only the
# bound ROLE differs. Written by deploy/console/gcp_federation.sh and renamed
# to A2ALAB_GCP_WORKLOAD_AUDIENCE / A2ALAB_GCP_IMPERSONATE_SA inside the task
# definition — setting those generic names here would put the LAPTOP into
# federation mode, where there is no AWS role to present.
#A2ALAB_CONSOLE_GCP_AUDIENCE=
#A2ALAB_CONSOLE_GCP_SA=

# ---- Strands AgentCore runtime — native-direct ADK federation (WS5) ------
# The cross-hyperscaler Strands -> Google ADK cell's DIRECT route. Same pool,
# provider and service account as the bridge/console pairs above; only the
# bound ROLE differs (the AgentCore runtime's execution role). Written by
# deploy/agentcore/gcp_federation.sh strands and renamed to
# A2ALAB_GCP_WORKLOAD_AUDIENCE / A2ALAB_GCP_IMPERSONATE_SA inside the runtime
# env by deploy/agentcore/deploy.sh — setting those generic names here would
# put the LAPTOP into federation mode, where there is no AWS role to present.
#A2ALAB_STRANDS_GCP_AUDIENCE=
#A2ALAB_STRANDS_GCP_SA=

# ---- Daily brief watcher (D16) -----------------------------------
# poll interval for the daily-brief watcher (D16)
#A2ALAB_BRIEF_POLL_S=

# ---- Target endpoints resolved by config/targets.yaml ------------
# A2A endpoint of the logistics fan-out leg on Agent Engine
#ADK_LOGISTICS_A2A_ENDPOINT=
# A2A endpoint of the ADK orchestrator variant (WS8)
#ADK_ORCHESTRATOR_A2A_ENDPOINT=

# ---- Lab console -------------------------------------------------
# where the console sends Path A runs; defaults to localhost:8100
#A2ALAB_BRIDGE_URL=
# branch the console's Architecture page links source files on
#A2ALAB_REPO_BRANCH=
# public repo the Architecture page links to
#A2ALAB_REPO_URL=

# ---- Fan-out MCP server (D41) ------------------------------------
# workload-identity audience for the fan-out Lambda (D41)
#A2ALAB_FANOUT_GCP_AUDIENCE=
# GCP service account the fan-out Lambda impersonates (D41)
#A2ALAB_FANOUT_GCP_SA=
# bearer token the fan-out MCP server requires (D41)
#A2ALAB_FANOUT_MCP_TOKEN=

# ---- Shared seams ------------------------------------------------
# override config/targets.yaml (tests and alternate registries)
#A2ALAB_TARGETS_PATH=
# public URL an A2A server advertises in its agent card
#A2A_PUBLIC_URL=
# token hosted runtimes present to the Agentforce shim
#AF_SHIM_TOKEN=
# Entra service principal used for Foundry calls (WS3)
#AZURE_CLIENT_ID=
# its secret — expires; watch scripts/expiry_report.py
#AZURE_CLIENT_SECRET=
# Entra tenant the service principal authenticates against
#AZURE_TENANT_ID=

# ---- Observability deploys (D23) ---------------------------------
# service-account key file shipped into the harvest secret
#A2ALAB_GCP_KEY_FILE=
# same, for the observability reader identity
#A2ALAB_GCP_OBS_KEY_FILE=

# ---- Obs MCP server (D23) ----------------------------------------
# bearer token for the hosted obs MCP server (D23)
#A2ALAB_OBS_MCP_TOKEN=

# ---- Observability harvest (M11) ---------------------------------
# how long to wait for the hosted obs analyst run (D23)
#A2ALAB_ANALYST_TIMEOUT_S=
# region for the PromQL client that reads coding-agent metrics
#A2ALAB_CW_REGION=

# ---- Fan-out orchestration (WS8) ---------------------------------
# per-leg cap for the SYNC fan-out path (blocking consult_*), kept under the
# API Gateway 29s ceiling on the remote MCP server (default 120s off-gateway)
#A2ALAB_LEG_TIMEOUT_S=
# per-leg cap for the ASYNC fire-then-poll WORKER — off the gateway path (a
# self-invoke Lambda, D47/WS11), so it gets a larger budget than the sync leg
# and a COLD platform (Foundry ~26.5s, Agent Engine ~34s) has room to finish;
# the Lambda function timeout must exceed this (default 120s)
#A2ALAB_ASYNC_LEG_TIMEOUT_S=
# async (fire-then-poll) dispatch cadence: seconds between tasks/get polls
# while a leg's task is still WORKING (WS11, default 1.0s)
#A2ALAB_ASYNC_POLL_INTERVAL_S=
# how long to ride through a not-yet-visible task after submit before treating
# the poll as a genuine submit-only failure — Agent Engine's task store is
# eventually consistent, so the first tasks/get can 404 then resolve (WS11,
# default 45s, wide enough to cover a ~34s cold start)
#A2ALAB_ASYNC_NOT_FOUND_GRACE_S=
# reverse Path A (Agentforce twin → LangGraph on Heroku, WS4/D77): total budget
# the BRIDGE gives its submit+poll loop when a target is flagged
# bridge_dispatch: submit_poll. Sits UNDER the Apex callout's 110s (so the
# bridge returns first) and ABOVE the LangGraph dyno's answer timeout
# (LANGGRAPH_ANSWER_TIMEOUT_S=90), so the remote fails cleanly before the bridge
# gives up. Default 100s.
#A2ALAB_BRIDGE_ASYNC_TIMEOUT_S=100
# Agentforce fan-out orchestrator (WS8 variant 3, D61) — set after the
# A2ALab_Supply_Orchestrator Agent Script bundle is published + activated
#SF_ORCHESTRATOR_AGENT_ID=

# ---- Platform backends -------------------------------------------
# turn cap for the self-hosted claude-agent-sdk backend
#CLAUDE_MAX_TURNS=
# Foundry agent's inbound A2A endpoint (WS3)
#FOUNDRY_A2A_ENDPOINT=
# how long the ADK orchestrator waits on its Foundry leg
#FOUNDRY_A2A_TIMEOUT_S=
# cap on the OpenAI agent's ask_agentforce tool call
#OPENAI_AGENTFORCE_TOOL_TIMEOUT_S=
# output cap for the OpenAI agents-sdk backend (D24)
#OPENAI_MAX_TOKENS=
# turn cap for the same
#OPENAI_MAX_TURNS=
# reasoning effort for the OpenAI agents-sdk backend
#OPENAI_REASONING_EFFORT=

# ---- Operator scripts --------------------------------------------
# region of the CloudWatch OTLP metrics endpoint (WS9)
#A2ALAB_CW_METRICS_REGION=
# Secrets Manager secret holding the CloudWatch metrics API key (WS9)
#A2ALAB_CW_METRICS_SECRET=
# full OTLP metrics URL for Codex; note the required /v1/metrics path
#A2ALAB_CW_OTLP_METRICS_ENDPOINT=
# --- CloudWatch LOGS OTLP path (WS16/D59, scripts/setup_cw_logs_otlp.py) ---
# The logs signal needs its own service-specific credential (a metrics token
# 403s against the logs endpoint) and a pre-provisioned log group. All three
# have working defaults in the script; set them only to override.
# IAM user carrying CloudWatchLogsAPIKeyAccess (default a2alab-cw-logs-otlp)
#A2ALAB_CW_LOGS_USER=
# log group OTLP ingests into (default /a2alab/coding-agents/otlp)
#A2ALAB_CW_LOGS_GROUP=
# Secrets Manager secret holding the logs API key (default a2alab/telemetry/cw-logs-api-key)
#A2ALAB_CW_LOGS_SECRET=
# region of the CloudWatch OTLP logs endpoint (scripts/claude_otel.sh + the
# coding_logs_source reader); defaults to AWS_REGION then us-east-1
#A2ALAB_CW_LOGS_REGION=
# log stream the launch wrapper writes/creates under the group (default claude-code)
#A2ALAB_CW_LOGS_STREAM=
# full OTLP logs URL; note the required /v1/logs path (default logs.<region>/v1/logs)
#A2ALAB_CW_OTLP_LOGS_ENDPOINT=
# Secrets Manager secret this .env syncs with (scripts/env_sync.py)
#A2ALAB_ENV_SECRET=
# model for the fan-out orchestrator agent
#A2ALAB_ORCHESTRATOR_MODEL=
# extra OTEL_RESOURCE_ATTRIBUTES appended by scripts/codex_otel.sh
#A2ALAB_OTEL_EXTRA_ATTRS=
# where provisioning state lands; defaults to .a2alab
#A2ALAB_STATE_DIR=
# whole-JSON state override for hosts with no .a2alab/ (D48) — the obs analyst's
# (D23) and cost sentinel's (WS12) deployment ids. Injected by deploy_console.sh;
# the console reads these before falling back to obs_analyst.json / cost_sentinel.json
#A2ALAB_OBS_ANALYST_STATE=
#A2ALAB_COST_SENTINEL_STATE=
# resolved CloudWatch bearer token (set by otel_headers.sh, not by hand)
#CW_METRICS_TOKEN=

# ---- Agentforce shim (D28) ---------------------------------------
# shim: log inbound headers (never leave on — they carry tokens)
#A2ALAB_DEBUG_HEADERS=
# public URL the hosted shim advertises in its agent card (D28)
#AF_SHIM_PUBLIC_URL=

# ---- Fan-out legs (WS8/D41) ------------------------------------------------
# Which target each business unit's leg calls. Named per unit so a leg can be
# repointed at a different platform without touching orchestration code.
#A2ALAB_LEG_COMMERCIAL_TARGET=
#A2ALAB_LEG_COMMS_TARGET=
#A2ALAB_LEG_EXPOSURE_TARGET=
# Agent Engine deployment ids for the fan-out legs, printed by
# deploy/adk/deploy_adk.py. The A2A endpoints above are derived from these.
#ADK_LOGISTICS_ENGINE_ID=
#ADK_ORCHESTRATOR_ENGINE_ID=

# IAM user holding the CloudWatch metrics API key (WS9) — expiry_report.py
# reads that key's expiry date from IAM.
#A2ALAB_CW_METRICS_USER=

# ---- MuleSoft Agent Fabric (WS10 SP1) --------------------------------------
# The deployed broker's gateway A2A ingress URL — the mule-broker-a2a target's
# endpoint (config/targets.yaml). Set post-deploy to the Omni Gateway ingress.
#A2ALAB_MULE_BROKER_URL=
# Lab client-credentials pair the Omni Gateway presents at the console
# /oauth/token mint to get a lab JWT as mulesoft-omni-gateway (identity.py
# SERVICE_CLIENTS). Provisioned as Anypoint secured deploy variables — never
# commit a value here.
#A2ALAB_MULE_GW_CLIENT_ID=
#A2ALAB_MULE_GW_CLIENT_SECRET=
# Service (machine) JWT TTL in seconds for the client-credentials mint;
# defaults to 300 (identity.py DEFAULT_SERVICE_TTL_S) when unset.
#A2ALAB_SERVICE_JWT_TTL_S=
