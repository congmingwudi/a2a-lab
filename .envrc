# Which Claude Code account this repo runs under. See the trap below before editing.
#
# PERSONAL: set the var. Config file is $CLAUDE_CONFIG_DIR/.claude.json.
#export CLAUDE_CONFIG_DIR="$HOME/.claude-personal"
#
# WORK (Salesforce): leave the var UNSET. Claude Code then reads the LEGACY config
# file ~/.claude.json (oauthAccount, mcp-adaptor, 26 projects) while still taking
# settings/plugins/skills from ~/.claude.
#
# TRAP: `export CLAUDE_CONFIG_DIR="$HOME/.claude"` does NOT select work. Setting the
# var moves the config file INSIDE the dir, so Claude Code reads
# ~/.claude/.claude.json — a different, near-empty file (no oauthAccount, no
# mcp-adaptor). That is not the work account; it just looks like a broken one.
unset CLAUDE_CONFIG_DIR
