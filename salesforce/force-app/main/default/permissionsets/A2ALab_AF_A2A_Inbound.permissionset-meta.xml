<?xml version="1.0" encoding="UTF-8"?>
<!-- The gate for the a2a_lab_af_a2a External Client App (client credentials), the
     caller app for the Agentforce inbound A2A pilot (D106; D86 pattern, D90). It grants
     nothing itself: the ECA's OAuth policy pre-authorizes THIS permission set instead of
     the System Administrator profile. Assign it to the target agent's OWN user only
     (the pilot's "Digital Agent User" run-as), never to an integration user, and never
     reuse that agent user across agents (the pilot's "Limitation 2"). -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>A2A lab: pre-authorizes the a2a_lab_af_a2a External Client App (Agentforce inbound A2A pilot, D106) for the target agent's own user. Grants no data access by itself (D90).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>A2ALab AF A2A Inbound</label>
</PermissionSet>
