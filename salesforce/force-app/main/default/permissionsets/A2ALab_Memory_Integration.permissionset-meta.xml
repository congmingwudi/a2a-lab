<?xml version="1.0" encoding="UTF-8"?>
<!-- The gate for the a2a_lab_memory ECA (D86, plan/18 Phase 0b). It grants
     nothing itself: the ECA's OAuth policy pre-authorizes THIS permission set
     instead of the System Administrator profile, so only users assigned it
     can be the JWT-bearer `sub`. Assign it to the dedicated memory integration
     user only (`scripts/setup_agentic_memory.py user`). The capabilities come
     from the standard Data Cloud User and Context Service permission sets.

     The one grant it does carry is Data Space access to the non-default
     memory probe space (AM-API-012, 2026-11-11). Data Cloud User reaches only
     `default` implicitly; without this the memory user gets 403 "end-user
     denied authorization" in A2ALabMemoryProbe. Metadata shape: a
     <dataspaceScopes> (type DataspaceScopeAccess) holding only
     <dataspaceScope>; an <enabled> child is rejected. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <dataspaceScopes>
        <dataspaceScope>A2ALabMemoryProbe</dataspaceScope>
    </dataspaceScopes>
    <description>A2A lab: pre-authorizes the a2a_lab_memory External Client App (JWT bearer) for the dedicated memory integration user, and grants Data Space access to the non-default memory probe space (D86, AM-API-012).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>A2ALab Memory Integration</label>
</PermissionSet>
