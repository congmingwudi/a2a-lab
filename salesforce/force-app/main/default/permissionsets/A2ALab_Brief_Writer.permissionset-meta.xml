<?xml version="1.0" encoding="UTF-8"?>
<!-- What the hosted brief writer (src/briefs/salesforce.py) does as a2a_lab_app's
     run-as user, and nothing else (D90): read Accounts, upsert the brief and its
     Task by delivery key, and send the A2ALab_Brief_Alert bell notification.
     Assigned with the A2ALab_Briefs_Integration gate by
     `scripts/integration_users.py briefs`; the Integration license needs the
     Salesforce API Integration permission set license for object access.
     Contact read is there only because the platform makes Account read depend
     on it. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>A2A lab: the brief writer's object access, for the briefs integration user (D90).</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>A2ALab_Account_Brief__c.A2ALab_Delivery_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>A2ALab_Account_Brief__c.Account__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>A2ALab_Account_Brief__c.Brief_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>A2ALab_Account_Brief__c.Brief__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>A2ALab_Account_Brief__c.Research_Session_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>A2ALab_Account_Brief__c.Source__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Task.A2ALab_Delivery_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>A2ALab Brief Writer</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>A2ALab_Account_Brief__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!-- Task is not even queryable without Access Activities: EditTask alone
         left it "sObject type 'Task' is not supported" (measured, D90). -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ActivitiesAccess</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>EditTask</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>SendCustomNotifications</name>
    </userPermissions>
</PermissionSet>
