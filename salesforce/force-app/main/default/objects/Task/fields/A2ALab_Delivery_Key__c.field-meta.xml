<?xml version="1.0" encoding="UTF-8"?>
<!-- The Task half of the delivery idempotency boundary (WS25 b3 / A4·F07, D81).
     Activities are disabled on A2ALab_Account_Brief__c, so the Task cannot hang
     off the brief; instead it carries the SAME `<research_session_id>#<account_id>`
     key, External Id + Unique, and is written by PATCH-upsert. This is what makes
     the brief+Task PAIR idempotent under a re-run or a concurrent losing writer —
     not just a Subject echo. Custom field on the standard Task object. -->
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>A2ALab_Delivery_Key__c</fullName>
    <label>A2ALab Delivery Key</label>
    <type>Text</type>
    <length>255</length>
    <required>false</required>
    <externalId>true</externalId>
    <unique>true</unique>
    <caseSensitive>false</caseSensitive>
    <trackTrending>false</trackTrending>
</CustomField>
